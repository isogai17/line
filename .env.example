# このファイルを.envにコピーして設定してください。キーをGitやチャットに貼らないでください。
# 空欄の場合は、外部APIを呼ばないサンプルモードで起動します。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000

# 初期値は自分のPCだけでアクセスできる設定です。
HOST=127.0.0.1
# 任意：アプリを開くための12文字以上のパスワード。
# 外部に公開する場合は必須です。OpenAIのキーとは別の値を設定してください。
APP_PASSWORD=
# 外部に公開する場合のみ、httpsの公開URLをパスなしで設定。
# Renderでは自動設定されるため空欄のままで構いません。
# 例: https://reply.example.com
APP_ORIGIN=
