{
  "name": "line-reply-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "文章を貼り付けてAIの返信案を作る、個人向けWebアプリ",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "demo": "node --env-file-if-exists=.env src/server.js --demo",
    "test": "node --test"
  }
}
